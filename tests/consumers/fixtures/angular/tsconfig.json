{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": false,
    "skipLibCheck": false,
    "lib": [
      "ES2024",
      "DOM"
    ],
    "types": [],
    "outDir": "compiled",
    "rootDir": ".",
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": [
    "*.ts"
  ],
  "angularCompilerOptions": {
    "compilationMode": "full",
    "strictTemplates": true
  }
}
