{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "allowJs": true,
    "checkJs": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2024",
      "DOM"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "tooling/**/*.mjs",
    "vitest.config.ts",
    "tests/contracts/**/*.test.ts",
    "tests/consumers/**/*.test.ts",
    "tests/browser/**/*.test.ts"
  ]
}
