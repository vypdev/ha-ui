{
  "name": "ha-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.consumers.json && svelte-check --tsconfig tsconfig.svelte-source.json && svelte-check --tsconfig tsconfig.svelte-tests.json && tsc --noEmit -p tsconfig.storybook.json",
    "test": "vitest run --coverage && node --test tests/coverage-evidence.test.mjs",
    "build": "pnpm -r --sort run build",
    "test:package": "node --test tests/consumers/packed.test.ts",
    "test:ssr": "node --test tests/consumers/ssr.test.mjs",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "pnpm build && storybook build --output-dir build/storybook",
    "test:storybook": "node --test tests/storybook/static.test.ts",
    "storybook:preview": "vite preview --outDir build/storybook --base /ha-ui/ --port 6006 --strictPort"
  },
  "devDependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@babel/core": "8.0.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/web-components-vite": "10.6.5",
    "@sveltejs/package": "3.0.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/chai": "5.2.3",
    "@types/convert-source-map": "2.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vypdev/ha-ui": "workspace:*",
    "axe-core": "4.14.0",
    "lit": "3.3.3",
    "ng-packagr": "22.2.5",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "roboto-fontface": "0.10.0",
    "rxjs": "7.8.2",
    "storybook": "10.6.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue": "3.5.44",
    "yaml": "2.9.0"
  }
}
