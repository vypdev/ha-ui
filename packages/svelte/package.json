{
  "name": "@vypdev/ha-ui-svelte",
  "version": "0.1.0-next.1",
  "description": "Svelte bindings for the shared Home Assistant UI components",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vypdev/ha-ui.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {
    "@vypdev/ha-ui": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "5.57.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "svelte": "./dist/index.js",
  "scripts": {
    "build": "svelte-package -i src -o dist --tsconfig tsconfig.json"
  }
}
