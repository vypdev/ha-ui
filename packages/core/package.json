{
  "name": "@vypdev/ha-ui",
  "version": "0.1.0-next.1",
  "description": "Shared presentation contracts and components for Home Assistant applications",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vypdev/ha-ui.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./tabs": {
      "types": "./dist/components/tabs.d.ts",
      "import": "./dist/components/tabs.js"
    },
    "./field-contracts": {
      "types": "./dist/field-contracts.d.ts",
      "import": "./dist/field-contracts.js"
    },
    "./field": {
      "types": "./dist/components/field.d.ts",
      "import": "./dist/components/field.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
